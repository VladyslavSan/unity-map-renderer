{
    "version": 8,
    "name": "OpenFreeMap (OpenMapTiles) — experiment",
    "zoom": 14,
    "pitch": 0,
    "bearing": 0,
    "center": [
        13.405,
        52.52
    ],
    "metadata": {
        "note": "Experimental style for the OpenFreeMap free OSM vector tiles (OpenMapTiles schema). Layer choices and colors tuned for VISIBILITY against a real Berlin z14 tile (landuse=main green; transportation rendered dark+wide so the road network reads against the background; buildings populate at z14). Source-layer names follow the OpenMapTiles spec."
    },
    "sources": {
        "openmaptiles": {
            "type": "vector",
            "url": "https://tiles.openfreemap.org/planet"
        }
    },
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#e9e4da"
            },
            "filter": [
                "all"
            ],
            "layout": {
                "visibility": "visible"
            }
        },
        {
            "id": "landuse",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landuse",
            "paint": {
                "fill-color": "#cfe0b0"
            },
            "filter": [
                "all"
            ],
            "layout": {
                "visibility": "visible"
            }
        },
        {
            "id": "landcover",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landcover",
            "paint": {
                "fill-color": "#bcd99a"
            },
            "filter": [
                "all"
            ],
            "layout": {
                "visibility": "visible"
            }
        },
        {
            "id": "water",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "water",
            "paint": {
                "fill-color": "#7fb0e0"
            },
            "filter": [
                "all"
            ],
            "layout": {
                "visibility": "visible"
            }
        },
        {
            "id": "building",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "building",
            "paint": {
                "fill-color": "#cbb89a"
            },
            "filter": [
                "all"
            ],
            "layout": {
                "visibility": "visible"
            },
            "minzoom": 13
        },
        {
            "id": "road-casing",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "paint": {
                "line-color": "#6b6b6b",
                "line-width": {
                    "stops": [
                        [
                            10,
                            2
                        ],
                        [
                            14,
                            7
                        ],
                        [
                            18,
                            22
                        ]
                    ]
                }
            },
            "filter": [
                "all"
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            }
        },
        {
            "id": "road-fill",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "paint": {
                "line-color": "#fdfdfb",
                "line-width": {
                    "stops": [
                        [
                            10,
                            1
                        ],
                        [
                            14,
                            4
                        ],
                        [
                            18,
                            15
                        ]
                    ]
                }
            },
            "filter": [
                "all"
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round",
                "visibility": "visible"
            }
        }
    ]
}
