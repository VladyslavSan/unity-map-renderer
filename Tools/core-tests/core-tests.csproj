<!--
  Fast, Unity-free unit tests for MapRenderer.Core. Compiles the REAL Core .cs files plus a tiny
  Unity.Mathematics shim, so pure-logic tests run via `dotnet test` in ~1s instead of a minutes-long
  Editor batch run (and without the Unity project lock).

  Engine-free EditMode test files are included VERBATIM (single source of truth — they also run in the
  Unity Test Framework). Tests that need the engine (MeshBuilder/UnityEngine.Mesh, NativeArray jobs,
  MonoBehaviours) stay Unity-only by design. NUnit pinned to 3.x to match Unity's runner API.

  Run:  dotnet test Tools/core-tests
-->
<Project Sdk="Microsoft.NET.Sdk">
