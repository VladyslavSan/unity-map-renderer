    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <AssemblyName>MapRenderer.Core.Tests</AssemblyName>
    <RootNamespace>MapRenderer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- S51: UniTask NetCore build (PlayerLoop-stripped subset) — same version as vendored Unity build.
         Provides UniTask<T>, RunOnThreadPool, SwitchToThreadPool, UniTaskCompletionSource, WhenAll.
         No .AsUniTask()/.AsTask() interop — avoids CS0012 trap (issue #716). -->
    <PackageReference Include="UniTask" Version="2.5.10" />
