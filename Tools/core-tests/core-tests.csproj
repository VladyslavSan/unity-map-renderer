<!--
  Fast, Unity-free unit tests for MapRenderer.Core. Compiles the REAL Core .cs files plus a tiny
  Unity.Mathematics shim, so pure-logic tests run via `dotnet test` in ~1s instead of a minutes-long
  Editor batch run (and without the Unity project lock).

  Engine-free EditMode test files are included VERBATIM (single source of truth — they also run in the
  Unity Test Framework). Tests that need the engine (MeshBuilder/UnityEngine.Mesh, NativeArray jobs,
  MonoBehaviours) stay Unity-only by design. NUnit pinned to 3.x to match Unity's runner API.

  Run:  dotnet test Tools/core-tests
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <AssemblyName>MapRenderer.Core.Tests</AssemblyName>
    <RootNamespace>MapRenderer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- S51: UniTask NetCore build (PlayerLoop-stripped subset) — same version as vendored Unity build.
         Provides UniTask<T>, RunOnThreadPool, SwitchToThreadPool, UniTaskCompletionSource, WhenAll.
         No .AsUniTask()/.AsTask() interop — avoids CS0012 trap (issue #716). -->
    <PackageReference Include="UniTask" Version="2.5.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Shim/**/*.cs" />
    <Compile Include="SphericalProjectionTests.cs" />
    <Compile Include="TileBufferClipTests.cs" />

